---
import { formatDate, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul>
  {
    posts.map((post) => (
      <li>
        <time class="mono muted" datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        <a href={`/blog/${post.id}/`}>
          <span class="title">
            {post.data.title}
            {post.data.draft && <span class="mono draft">草稿</span>}
          </span>
          {post.data.description && <span class="desc">{post.data.description}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    align-items: baseline;
    gap: 0.5rem;
    margin-inline: -0.75rem;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    transition: background-color 0.15s;
  }

  li:hover {
    background: var(--surface);
  }

  a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .title {
    font-weight: 500;
  }

  .desc {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .draft {
    margin-left: 0.5rem;
    padding: 0.1em 0.45em;
    border-radius: 4px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  @media (max-width: 30rem) {
    li {
      grid-template-columns: 1fr;
      gap: 0;
      padding-block: 0.6rem;
    }
  }
</style>
