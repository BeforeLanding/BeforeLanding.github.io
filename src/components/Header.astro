---
import { NAV, SITE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.title} 首页`}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M3 5 L15 17" class="glide"></path>
        <path d="M3 19 H21" class="ground"></path>
        <circle cx="16.4" cy="18.4" r="1.6" class="dot"></circle>
      </svg>
      <span>{SITE.title}</span>
    </a>

    <nav aria-label="主导航">
      {
        NAV.map(({ href, label }) => (
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
      <button id="theme-toggle" type="button" aria-label="切换明暗主题" title="切换明暗主题">
        <svg class="sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .brand svg {
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .glide {
    stroke: var(--accent);
    stroke-dasharray: 2.5 3;
  }

  .ground {
    stroke: currentColor;
  }

  .dot {
    fill: var(--accent);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.9375rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    font-weight: 600;
  }

  button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-right: -0.4rem;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }

  button:hover {
    background: var(--surface);
    color: var(--text);
  }

  button svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :global([data-theme='dark']) .sun,
  :global([data-theme='light']) .moon,
  :global(:root:not([data-theme])) .moon {
    display: none;
  }

  @media (max-width: 30rem) {
    nav {
      gap: 0.9rem;
    }
  }
</style>
