---
import { NAV, SITE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.title} 首页`}>
      <img class="avatar" src="/images/avatar.webp" alt="" width="26" height="26" />
      <span>{SITE.title}</span>
    </a>

    <nav aria-label="主导航">
      {
        NAV.map(({ href, label }) => (
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
      <button data-theme-toggle type="button" aria-label="切换明暗主题" title="切换明暗主题">
        <svg class="sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
          ></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .avatar {
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--glass-border);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.9375rem;
  }

  nav a {
    padding: 0.3rem 0.7rem;
    white-space: nowrap;
    border-radius: 6px;
    color: var(--muted);
    text-decoration: none;
    transition:
      color 0.15s,
      background-color 0.15s;
  }

  nav a:hover {
    background: var(--surface);
    color: var(--text);
  }

  nav a[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }

  button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-left: 0.25rem;
    margin-right: -0.4rem;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }

  button:hover {
    background: var(--surface);
    color: var(--text);
  }

  button svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :global([data-theme='dark']) .sun,
  :global([data-theme='light']) .moon,
  :global(:root:not([data-theme])) .moon {
    display: none;
  }

  @media (max-width: 30rem) {
    .brand span {
      display: none;
    }

    nav {
      gap: 0;
    }

    nav a {
      padding-inline: 0.5rem;
    }
  }
</style>
