---
import { SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer>
  <div class="wrap row mono">
    <span>© {year} {SITE.author}</span>
    <span class="links">
      <a href={SITE.github} rel="me noopener" target="_blank">GitHub</a>
      {SITE.email && <a href={`mailto:${SITE.email}`}>Email</a>}
      <a href="/rss.xml">RSS</a>
    </span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    color: var(--muted);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  a {
    text-decoration: none;
  }
</style>
