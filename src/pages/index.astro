---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
import { GALLERY, TRACKS } from '../data/keion';
import { PROJECTS } from '../data/projects';
import { formatDate, getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 4);
const firstName = SITE.author.split(' ')[0];

// 「我的项目」：精选项目，默认展示 mini-DSH
const DEFAULT_PROJECT = 'mini-DSH';
const showcase = PROJECTS.filter((p) => p.featured).sort(
  (a, b) => Number(b.name === DEFAULT_PROJECT) - Number(a.name === DEFAULT_PROJECT),
);

// 只收录 public/music/ 下真实存在音频的曲目
const musicDir = join(process.cwd(), 'public', 'music');
const playable = TRACKS.flatMap((t) => {
  const ext = ['m4a', 'mp3'].find((e) => existsSync(join(musicDir, `${t.slug}.${e}`)));
  if (!ext) return [];
  const cover = existsSync(join(musicDir, `${t.slug}.jpg`)) ? `/music/${t.slug}.jpg` : '/images/avatar.webp';
  return [{ ...t, url: `/music/${t.slug}.${ext}`, cover }];
});

const GITHUB_ICON =
  'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z';
const MAIL_ICON =
  'M1.75 2h12.5c.97 0 1.75.78 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25v-8.5C0 2.78.78 2 1.75 2ZM1.5 5.1v7.15c0 .14.11.25.25.25h12.5c.14 0 .25-.11.25-.25V5.1L8.4 9.07a.75.75 0 0 1-.8 0L1.5 5.1Zm12.89-1.6H1.61L8 7.52l6.39-4.02Z';
const RSS_ICON =
  'M2 2.75A.75.75 0 0 1 2.75 2C8.963 2 14 7.037 14 13.25a.75.75 0 0 1-1.5 0A9.75 9.75 0 0 0 2.75 3.5.75.75 0 0 1 2 2.75Zm0 4.5a.75.75 0 0 1 .75-.75 6.75 6.75 0 0 1 6.75 6.75.75.75 0 0 1-1.5 0C8 10.35 5.65 8 2.75 8A.75.75 0 0 1 2 7.25ZM3 11a2 2 0 1 1 0 4 2 2 0 0 1 0-4Z';
---

<Base home>
  <div class="page">
    <!-- 首屏：左边自我介绍，右边拍立得相册 -->
    <section class="hero">
      <div class="intro">
        <p class="hello mono">
          <span class="dot" aria-hidden="true"></span>
          <span data-greet>你好呀</span>
          <span class="sep" aria-hidden="true">·</span>
          <span data-clock>--:--</span>
        </p>
        <h1>
          我是 <span class="name">{firstName}</span>
        </h1>
        <p class="lead">
          NUS 人工智能硕士在读，最近在关注 Coding Agent Harness 和 AI for Math 的最新热点。
        </p>
        <div class="actions">
          <a class="btn primary" href="/projects/">看看我的项目 →</a>
          <a class="btn round" href={SITE.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d={GITHUB_ICON}></path></svg>
          </a>
          {
            SITE.email && (
              <a class="btn round" href={`mailto:${SITE.email}`} aria-label="Email" title="Email">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d={MAIL_ICON}></path></svg>
              </a>
            )
          }
          <a class="btn round" href="/rss.xml" aria-label="RSS 订阅" title="RSS 订阅">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d={RSS_ICON}></path></svg>
          </a>
        </div>
      </div>

      <div class="album" data-album>
        {
          GALLERY.map((g, i) => (
            <button type="button" class:list={['polaroid', `p${i}`]} data-photo aria-label={`换一张：${g.caption}`}>
              <img src={g.src} alt={g.caption} loading={i === 0 ? 'eager' : 'lazy'} />
              <span class="caption">{g.caption}</span>
            </button>
          ))
        }
        <img class="sticker" src="/images/avatar.webp" alt={`${firstName} 的头像`} width="104" height="104" />
        <span class="doodle" aria-hidden="true">♪</span>
      </div>
    </section>

    <!-- 第二屏：我的项目 + 最新文章 -->
    <div class="row">
      <section class="glass panel projects" aria-labelledby="proj-title">
        <header class="panel-head">
          <h2 id="proj-title">我的项目</h2>
          <a href="/projects/">全部 →</a>
        </header>
        <div class="tabs" role="tablist" aria-label="切换项目">
          {
            showcase.map((p, i) => (
              <button type="button" role="tab" id={`tab-${i}`} aria-controls={`proj-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={i}>
                {p.name}
              </button>
            ))
          }
        </div>
        {
          showcase.map((p, i) => (
            <article class="proj" id={`proj-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`} hidden={i !== 0}>
              <h3>
                <a href={p.repo} target="_blank" rel="noopener">
                  {p.name} <span aria-hidden="true">↗</span>
                </a>
              </h3>
              <p>{p.description}</p>
              <ul class="chips" aria-label="技术栈">
                {p.stack.map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </section>

      <section class="glass panel posts" aria-labelledby="post-title">
        <header class="panel-head">
          <h2 id="post-title">最新文章</h2>
          <a href="/blog/">全部 →</a>
        </header>
        {
          posts.length > 0 ? (
            <ol role="list">
              {posts.map((post) => (
                <li>
                  <time class="mono" datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate).slice(5)}
                  </time>
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="muted">还没有文章，很快就来。</p>
          )
        }
      </section>
    </div>
  </div>

  {
    playable.length > 0 && (
      <aside class="dock glass" aria-label="随机播放轻音少女" data-player data-tracks={JSON.stringify(playable)}>
        <span class="disc" aria-hidden="true">
          <img src={playable[0].cover} alt="" data-cover />
        </span>
        <span class="meta">
          <strong data-title>{playable[0].title}</strong>
          <span data-artist>{playable[0].artist}</span>
        </span>
        <button type="button" class="ctl play" data-toggle aria-label="播放">
          <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5.5v13l11-6.5-11-6.5Z" />
          </svg>
          <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" />
          </svg>
        </button>
        <button type="button" class="ctl" data-next aria-label="随机下一首" title="随机下一首">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 5.5v13l9-6.5-9-6.5ZM16.5 5H19v14h-2.5z" />
          </svg>
        </button>
        <span class="progress" aria-hidden="true"><span data-progress></span></span>
        <audio preload="none" data-audio></audio>
      </aside>
    )
  }
</Base>

<script>
  const pad = (n: number) => String(n).padStart(2, '0');

  // 问候语 + 时间
  const greetEl = document.querySelector<HTMLElement>('[data-greet]');
  const clockEl = document.querySelector<HTMLElement>('[data-clock]');
  function greeting(h: number): string {
    if (h < 5) return '夜深了，早点休息';
    if (h < 11) return '早上好';
    if (h < 14) return '中午好';
    if (h < 18) return '下午好';
    return '晚上好';
  }
  function tick() {
    const now = new Date();
    if (greetEl) greetEl.textContent = greeting(now.getHours());
    if (clockEl) clockEl.textContent = `${pad(now.getHours())}:${pad(now.getMinutes())}`;
  }
  tick();
  setInterval(tick, 10_000);

  // 拍立得：点最上面那张，换到另一张
  const album = document.querySelector<HTMLElement>('[data-album]');
  album?.querySelectorAll<HTMLButtonElement>('[data-photo]').forEach((photo) =>
    photo.addEventListener('click', () => album.classList.toggle('swapped')),
  );

  // 我的项目：标签切换（左右方向键也可以）
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  function select(i: number) {
    tabs.forEach((t, j) => {
      const on = j === i;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !on;
    });
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      const next = (i + step + tabs.length) % tabs.length;
      select(next);
      tabs[next].focus();
    });
  });

  // 角落里的随机播放器：随机选一首，点播放才出声；播完或点下一首随机换一首不重复的
  interface PlayableTrack {
    title: string;
    artist: string;
    url: string;
    cover: string;
  }
  const player = document.querySelector<HTMLElement>('[data-player]');
  const audio = player?.querySelector<HTMLAudioElement>('[data-audio]');
  if (player && audio) {
    const tracks: PlayableTrack[] = JSON.parse(player.dataset.tracks ?? '[]');
    const q = <T extends Element>(sel: string) => player.querySelector<T>(sel);
    const titleEl = q<HTMLElement>('[data-title]');
    const artistEl = q<HTMLElement>('[data-artist]');
    const coverEl = q<HTMLImageElement>('[data-cover]');
    const toggle = q<HTMLButtonElement>('[data-toggle]');
    const progress = q<HTMLElement>('[data-progress]');
    let index = -1;

    const load = (i: number) => {
      index = i;
      const t = tracks[i];
      audio.src = t.url;
      if (titleEl) titleEl.textContent = t.title;
      if (artistEl) artistEl.textContent = t.artist;
      if (coverEl) coverEl.src = t.cover;
      if (progress) progress.style.width = '0%';
    };
    const randomOther = () => {
      if (tracks.length < 2) return 0;
      let i = index;
      while (i === index) i = Math.floor(Math.random() * tracks.length);
      return i;
    };

    load(Math.floor(Math.random() * tracks.length));
    audio.volume = 0.6;

    toggle?.addEventListener('click', () => (audio.paused ? audio.play() : audio.pause()));
    q<HTMLButtonElement>('[data-next]')?.addEventListener('click', () => {
      const playing = !audio.paused;
      load(randomOther());
      if (playing) audio.play();
    });
    audio.addEventListener('ended', () => {
      load(randomOther());
      audio.play();
    });
    audio.addEventListener('play', () => {
      player.classList.add('playing');
      toggle?.setAttribute('aria-label', '暂停');
    });
    audio.addEventListener('pause', () => {
      player.classList.remove('playing');
      toggle?.setAttribute('aria-label', '播放');
    });
    audio.addEventListener('timeupdate', () => {
      if (progress && audio.duration) progress.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
    });
  }
</script>

<style>
  .page {
    width: 100%;
    max-width: 68rem;
    margin-inline: auto;
    padding: 0 1.5rem 7rem;
  }

  /* ---------- 首屏 ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: 3rem;
    min-height: calc(100vh - 3.75rem);
    min-height: calc(100svh - 3.75rem);
    padding-block: 3rem 4rem;
  }

  .hello {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.4rem;
    padding: 0.3rem 0.9rem 0.3rem 0.7rem;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass);
    color: var(--muted);
    box-shadow: var(--shadow);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #7fc28a;
    box-shadow: 0 0 0 3px rgb(127 194 138 / 0.25);
  }

  .sep {
    opacity: 0.5;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 5.2vw, 3.6rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .name {
    position: relative;
    color: var(--accent);
    white-space: nowrap;
  }

  /* 名字下面的荧光笔划线 */
  .name::after {
    content: '';
    position: absolute;
    left: -0.1em;
    right: -0.1em;
    bottom: 0.08em;
    z-index: -1;
    height: 0.32em;
    border-radius: 0.2em;
    background: rgb(247 182 200 / 0.55);
    transform: rotate(-1.5deg);
  }

  .lead {
    max-width: 30rem;
    margin: 1.4rem 0 0;
    color: var(--text);
    font-size: 1.0625rem;
    opacity: 0.82;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .actions .btn {
    height: 2.75rem;
    border-radius: 999px;
    box-shadow: var(--shadow);
  }

  .actions .btn.primary {
    padding-inline: 1.3rem;
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  .actions .btn.primary:hover {
    filter: brightness(1.08);
    color: var(--bg);
  }

  .btn.round {
    justify-content: center;
    width: 2.75rem;
    padding: 0;
    border-color: var(--glass-border);
    background: var(--glass);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .btn.round svg {
    width: 18px;
    height: 18px;
  }

  /* 拍立得相册 */
  .album {
    position: relative;
    height: clamp(20rem, 36vw, 27rem);
  }

  .polaroid {
    position: absolute;
    display: flex;
    flex-direction: column;
    width: 74%;
    padding: 0.7rem 0.7rem 0;
    border: 0;
    border-radius: 4px;
    background: var(--photo-frame, #fffdf9);
    box-shadow:
      0 2px 4px rgb(80 50 40 / 0.08),
      0 22px 40px -18px rgb(80 50 40 / 0.45);
    cursor: pointer;
    font: inherit;
    transition:
      transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1),
      z-index 0s 0.3s;
  }

  :global([data-theme='dark']) .polaroid {
    --photo-frame: #2e2a3d;
  }

  /* 和纸胶带 */
  .polaroid::before {
    content: '';
    position: absolute;
    top: -0.75rem;
    left: 50%;
    width: 5.5rem;
    height: 1.5rem;
    background: repeating-linear-gradient(
      -45deg,
      rgb(247 182 200 / 0.75) 0 6px,
      rgb(255 225 233 / 0.75) 6px 12px
    );
    transform: translateX(-50%) rotate(-3deg);
  }

  .polaroid.p1::before {
    background: repeating-linear-gradient(
      -45deg,
      rgb(176 214 160 / 0.75) 0 6px,
      rgb(220 239 210 / 0.75) 6px 12px
    );
    transform: translateX(-50%) rotate(4deg);
  }

  .polaroid img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
  }

  .caption {
    padding: 0.7rem 0.2rem 0.9rem;
    color: #6b5550;
    font-size: 0.875rem;
    text-align: center;
    letter-spacing: 0.04em;
  }

  :global([data-theme='dark']) .caption {
    color: var(--muted);
  }

  .p0 {
    top: 0;
    left: 0;
    z-index: 2;
    transform: rotate(-5deg);
  }

  .p1 {
    right: 0;
    bottom: 0;
    z-index: 1;
    transform: rotate(6deg);
  }

  .album:hover .p0 {
    transform: rotate(-7deg) translate(-0.6rem, -0.4rem);
  }

  .album:hover .p1 {
    transform: rotate(8deg) translate(0.6rem, 0.4rem);
  }

  .album.swapped .p0 {
    z-index: 1;
  }

  .album.swapped .p1 {
    z-index: 2;
  }

  .sticker {
    position: absolute;
    right: 2%;
    top: -0.5rem;
    z-index: 3;
    width: 6.5rem;
    height: 6.5rem;
    border: 5px solid var(--photo-frame, #fffdf9);
    border-radius: 50%;
    box-shadow: 0 14px 28px -12px rgb(80 50 40 / 0.5);
    transform: rotate(8deg);
    transition: transform 0.4s ease;
  }

  :global([data-theme='dark']) .sticker {
    --photo-frame: #2e2a3d;
  }

  .sticker:hover {
    transform: rotate(-4deg) scale(1.06);
  }

  .doodle {
    position: absolute;
    left: 4%;
    bottom: 6%;
    z-index: 3;
    color: var(--accent);
    font-size: 2.2rem;
    transform: rotate(-12deg);
    animation: bob 3.5s ease-in-out infinite;
  }

  @keyframes bob {
    50% {
      transform: rotate(-4deg) translateY(-6px);
    }
  }

  /* ---------- 我的项目 + 最新文章 ---------- */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .panel {
    padding: 1.5rem 1.6rem 1.6rem;
  }

  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .panel-head h2 {
    position: relative;
    margin: 0;
    padding-left: 0.85rem;
    font-size: 1.125rem;
  }

  .panel-head h2::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.2em;
    bottom: 0.2em;
    width: 4px;
    border-radius: 4px;
    background: var(--accent);
  }

  .panel-head a {
    color: var(--muted);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.1rem;
  }

  .tabs button {
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  .tabs button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .tabs button[aria-selected='true'] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  .proj h3 {
    margin: 0 0 0.4rem;
    font-size: 1.375rem;
  }

  .proj h3 a {
    text-decoration: none;
  }

  .proj h3 span {
    color: var(--muted);
    font-size: 0.8em;
  }

  .proj p {
    margin: 0 0 1rem;
    color: var(--text);
    opacity: 0.85;
    font-size: 0.9875rem;
  }

  .posts ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts li {
    position: relative;
    display: flex;
    gap: 0.9rem;
    padding: 0.55rem 0 0.55rem 1.1rem;
    border-left: 2px dashed var(--border);
  }

  .posts li::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 1.05rem;
    width: 10px;
    height: 10px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
  }

  .posts time {
    flex: none;
    padding-top: 0.1rem;
    color: var(--muted);
  }

  .posts a {
    font-size: 0.9875rem;
    text-decoration: none;
  }

  /* ---------- 角落播放器 ---------- */
  .dock {
    position: fixed;
    left: 1.25rem;
    bottom: 1.25rem;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: min(20rem, calc(100vw - 2.5rem));
    padding: 0.5rem 0.6rem 0.5rem 0.5rem;
    overflow: hidden;
    border-radius: 999px;
  }

  .disc {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.25rem;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, #3b2f2c 0 2px, #4a3d39 2px 4px);
    animation: spin 9s linear infinite paused;
  }

  .disc img {
    display: block;
