---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { HOME_POST_COUNT, SITE } from '../consts';
import { PROJECTS } from '../data/projects';
import { EDUCATION, EXPERIENCE } from '../data/resume';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, HOME_POST_COUNT);
const featured = PROJECTS.filter((p) => p.featured);

const FOCUS = ['编程 Agent 运行时', 'RAG 与混合检索', '离线评测'];
const GITHUB_ICON =
  'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z';
const MAIL_ICON =
  'M1.75 2h12.5c.97 0 1.75.78 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25v-8.5C0 2.78.78 2 1.75 2ZM1.5 5.1v7.15c0 .14.11.25.25.25h12.5c.14 0 .25-.11.25-.25V5.1L8.4 9.07a.75.75 0 0 1-.8 0L1.5 5.1Zm12.89-1.6H1.61L8 7.52l6.39-4.02Z';
---

<Base>
  <section class="hero">
    <p class="mono kicker"><span class="pulse" aria-hidden="true"></span>{SITE.tagline}</p>
    <h1>你好，我是 <span class="name">{SITE.author.split(' ')[0]}</span>。</h1>
    <p class="lead">
      我在新加坡国立大学读人工智能硕士，本科读数学，目前聚焦编程 Agent 运行时、RAG 与评测。
    </p>
    <ul class="chips focus" aria-label="关注方向">
      {FOCUS.map((f) => <li class="chip">{f}</li>)}
    </ul>
    <nav class="cta" aria-label="快捷入口">
      <a class="btn primary" href="/projects/">看项目</a>
      <a class="btn" href={SITE.github} target="_blank" rel="noopener">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d={GITHUB_ICON}></path></svg>GitHub
      </a>
      {
        SITE.email && (
          <a class="btn" href={`mailto:${SITE.email}`}>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d={MAIL_ICON}></path></svg>Email
          </a>
        )
      }
      <a class="more" href="/about/">完整经历 →</a>
    </nav>

    <!-- 下滑道：虚线进近，落在跑道上 -->
    <svg class="approach" viewBox="0 0 680 56" preserveAspectRatio="none" aria-hidden="true">
      <path class="glide" d="M0 4 L520 50" vector-effect="non-scaling-stroke"></path>
      <path class="ground" d="M0 50 H680" vector-effect="non-scaling-stroke"></path>
      <path
        class="runway"
        d="M540 50 v-6 M560 50 v-6 M580 50 v-6 M600 50 v-6 M620 50 v-6 M640 50 v-6 M660 50 v-6"
        vector-effect="non-scaling-stroke"></path>
    </svg>
  </section>

  <h2 class="section-title">精选项目 <a href="/projects/">全部 →</a></h2>
  <div class="grid">
    {featured.map((project) => <ProjectCard project={project} />)}
  </div>

  <h2 class="section-title">经历速览 <a href="/about/">详细经历 →</a></h2>
  <div class="resume">
    <section>
      <h3 class="mono muted">教育</h3>
      <ul role="list">
        {
          EDUCATION.map(({ school, major, degree, period }) => (
            <li>
              <span>
                <strong>{school}</strong> <span class="muted">{major} · {degree}</span>
              </span>
              <span class="mono muted period">{period}</span>
            </li>
          ))
        }
      </ul>
    </section>
    <section>
      <h3 class="mono muted">实习</h3>
      <ul role="list">
        {
          EXPERIENCE.map(({ company, role, period }) => (
            <li>
              <span>
                <strong>{company}</strong> <span class="muted">{role}</span>
              </span>
              <span class="mono muted period">{period}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <h2 class="section-title">最新文章 <a href="/blog/">全部 →</a></h2>
  {posts.length > 0 ? <PostList posts={posts} /> : <p class="muted">还没有文章，很快就来。</p>}
</Base>

<style>
  .hero {
    padding-top: 2rem;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1rem;
    padding: 0.2rem 0.75rem 0.2rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    letter-spacing: 0.12em;
  }

  .pulse {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent-soft);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 45%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 0.45rem transparent;
    }
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.1rem, 7vw, 3rem);
    letter-spacing: -0.02em;
  }

  .name {
    color: var(--accent);
  }

  .lead {
    margin: 0;
    max-width: 36rem;
    color: var(--muted);
    font-size: 1.125rem;
  }

  .focus {
    margin-top: 1.1rem;
  }

  .focus .chip {
    font-size: 0.8125rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  .more {
    margin-left: 0.4rem;
    color: var(--muted);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .approach {
    display: block;
    width: 100%;
    height: 56px;
    margin-top: 2.5rem;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .glide {
    stroke: var(--accent);
    stroke-dasharray: 5 7;
    animation: glide 1.6s linear infinite;
  }

  @keyframes glide {
    to {
      stroke-dashoffset: -12;
    }
  }

  .ground {
    stroke: var(--border);
  }

  .runway {
    stroke: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 0.9rem;
  }

  .resume {
    display: grid;
    gap: 1.1rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }

  .resume h3 {
    margin: 0 0 0.2rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .resume ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resume li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.15rem 1rem;
    padding-block: 0.4rem;
    font-size: 0.9375rem;
  }

  .resume li + li {
    border-top: 1px dashed var(--border);
  }

  .resume strong {
    margin-inline-end: 0.35rem;
  }

  .period {
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse,
    .glide {
      animation: none;
    }
  }
</style>
